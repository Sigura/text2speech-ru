[project]
name = "text2audio-lang-${code}"
version = "0.1.0"
description = "${name} language pack for text2audio: text structure, normalization, voices"
requires-python = ">=3.11"
# Pure-Python text rules only; models run as workers in their own environments (ADR-0004).
dependencies = ["text2audio"]

[project.entry-points."text2audio.languages"]
${code} = "text2audio_lang_${code}:PROFILE"

[project.entry-points."text2audio.normalizers"]
${code} = "text2audio_lang_${code}.normalize:Normalizer"

[tool.uv.sources]
text2audio = { workspace = true }

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/text2audio_lang_${code}"]
